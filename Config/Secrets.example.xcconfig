// Okta OIDC build settings — committed placeholders only.
// Copy this as Config/Secrets.local.xcconfig and fill in real values,
// OR let setup.sh generate Config/Secrets.local.xcconfig from your
// exported OKTA_* environment variables.
//
// xcconfig gotcha: a bare `//` starts an end-of-line comment, so the
// `://` in a URL must be written as `:/$()/` — the `$()` is an empty
// build-setting reference that breaks up the `//` token without
// changing the resulting string.
OKTA_ISSUER = https:/$()/placeholder.invalid/oauth2/default
OKTA_CLIENT_ID = PLACEHOLDER_CLIENT_ID
OKTA_REDIRECT_URI = com.acmebank.mobile:/$()/callback
OKTA_SCOPES = openid profile offline_access

// Pull in real secrets when present. The `?` form makes the include
// optional, so the build still works when Secrets.local.xcconfig is
// absent (it just leaves the placeholder values above in place, and
// `OktaConfig.load()` returns `.notConfigured` at runtime).
#include? "Secrets.local.xcconfig"
